{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrothemetransition"
  ],
  "ios": {
    "iosModuleName": "NitroThemeTransition"
  },
  "android": {
    "androidNamespace": [
      "nitrothemetransition"
    ],
    "androidCxxLibName": "NitroThemeTransition"
  },
  "autolinking": {
    "ThemeTransition": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridThemeTransition"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridThemeTransition"
      }
    }
  }
}
