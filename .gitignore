# Dependencies
node_modules/

# Build output — `bob build` regenerates it, `prepare` runs on publish.
lib/

# NOTE: nitrogen/generated is COMMITTED on purpose. CocoaPods needs it at
# `pod install` time and Gradle needs it at sync time, so it has to be in the
# published tarball and in the repo.

# Native build artefacts
android/build/
android/.cxx/
android/.gradle/
ios/build/
*.apk
*.xcworkspace
!example/ios/*.xcworkspace

# Expo / RN
.expo/
dist/
web-build/

# macOS
.DS_Store

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Editors
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Local env
.env*.local

# The example's native projects are GENERATED by `expo prebuild` — regenerate
# them with `cd example && bun run prebuild` rather than committing them.
example/android/
example/ios/

# Scaffolder leftovers
.claude/
example/.claude/
