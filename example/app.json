{
  "expo": {
    "name": "Theme Transition",
    "slug": "nitro-theme-transition-example",
    "scheme": "nitrothemetransition",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nitrothemetransition.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.nitrothemetransition.example"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-image"]
  }
}
